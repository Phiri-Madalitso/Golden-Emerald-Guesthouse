@{
    var pageTitle = ViewData["Title"] != null ? ViewData["Title"] + " | Golden Emerald Guest House" : "Golden Emerald Guest House | Your Stop Along the M18";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle</title>
    <meta name="description" content="Golden Emerald Guest House | comfortable, secure lodging along the M18, Zambia." />
    <meta name="theme-color" content="#0F2E20" />
    <meta property="og:title" content="Golden Emerald Guest House" />
    <meta property="og:description" content="Comfortable, secure lodging along the M18, Zambia." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="__SITE_URL__/" />
    <meta property="og:image" content="__SITE_URL__/images/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href="__SITE_URL__/" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,500&family=Work+Sans:wght@400;500;600;700&family=DM+Mono:wght@500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="nav">
            <a href="~/" class="brand" aria-label="Golden Emerald Guest House">
                <img src="~/images/logo.svg" alt="" class="brand-logo" width="44" height="44" />
                <span class="brand-text">
                    <span class="brand-name">Golden Emerald</span>
                    <span class="brand-sub">Guest House</span>
                </span>
            </a>
            <ul class="links" id="navLinks">
                <li><a href="#about">About</a></li>
                <li><a href="#rooms">Rooms</a></li>
                <li><a href="#amenities">Amenities</a></li>
                <li><a href="#gallery">Gallery</a></li>
                <li><a href="#location">Location</a></li>
            </ul>
            <a href="#contact" class="nav-cta">Book now</a>
            <button class="menu-btn" id="menuBtn" type="button" aria-label="Open menu" aria-controls="navLinks" aria-expanded="false"><span></span><span></span><span></span></button>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <div class="wrap footer-row">
            <a href="~/" class="brand">
                <img src="~/images/logo.svg" alt="" class="brand-logo footer-logo" width="36" height="36" />
                <span class="brand-name">Golden Emerald Guest House</span>
            </a>
            <p>M18, Zambia. © <span id="year"></span> Golden Emerald Guest House</p>
        </div>
    </footer>

    <nav class="mobile-bar" aria-label="Quick contact">
        <a class="call" href="tel:+260762512858">Call</a>
        <a class="wa" href="https://wa.me/260762512858" target="_blank" rel="noopener">WhatsApp</a>
    </nav>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>