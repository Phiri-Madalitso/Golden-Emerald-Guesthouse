@page 
@{
    ViewData["Title"] = "Home";
}
<section class="hero" aria-roledescription="carousel" aria-label="Photos of Golden Emerald Guest House">
  <div class="hero-slides">
    <img class="hero-slide active" src="~/images/hd/hero-1.jpg" asp-append-version="true" alt="Thatched guest house with a path through the garden" style="object-position:center 60%" />
    <img class="hero-slide" src="~/images/hd/hero-2.jpg" asp-append-version="true" alt="Guest house with a wooden veranda" style="object-position:center 55%" />
  </div>
  <div class="hero-overlay"></div>
  <div class="wrap hero-content">
    <h1>Rest easy along the M18.</h1>
    <p class="lede">Secure, comfortable rooms in Zambia.</p>
    <div class="btn-row">
      <a href="#contact" class="btn btn-gold">Book your stay</a>
      <a href="#rooms" class="btn btn-outline">View rooms</a>
    </div>
  </div>
  <div class="hero-controls">
    <button type="button" class="hero-arrow" id="heroPrev" aria-label="Previous photo"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 5l-7 7 7 7"/></svg></button>
    <div class="hero-dots" id="heroDots"></div>
    <button type="button" class="hero-arrow" id="heroNext" aria-label="Next photo"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5l7 7-7 7"/></svg></button>
  </div>
</section>

<div class="trust">
  <div class="wrap trust-row">
    <div><strong>Gated</strong><span>and watched 24/7</span></div>
    <div><strong>Fresh meals</strong><span>from our own farm</span></div>
    <div><strong>Hot water</strong><span>and Wi-Fi included</span></div>
    <div><strong>Late arrivals</strong><span>welcome</span></div>
  </div>
</div>

<section id="about">
  <div class="wrap">
    <div class="about-grid reveal">
      <div class="photo" style="aspect-ratio:5/4;">
        <img src="~/images/hd/front-view.jpg" asp-append-version="true" alt="Front view of Golden Emerald Guest House" />
        <span class="photo-label">Front view</span>
      </div>
      <div class="about-copy">
        <span class="eyebrow">About the guest house</span>
        <h2>A quiet, secure stop between destinations.</h2>
        <p>Golden Emerald Guest House sits along the M18, offering clean rooms, a gated compound, and a genuinely friendly welcome. Whether you're a traveller on the road or visiting family nearby, we aim to make your stay easy and comfortable.</p>
        <p>Family-run, close to local transport routes, and built around one idea: guests should leave feeling looked after.</p>
        <div class="about-stats">
          <div><div class="num">24/7</div><div class="lbl">Gated security</div></div>
          <div><div class="num">M18</div><div class="lbl">On the main road</div></div>
          <div><div class="num">2</div><div class="lbl">Room types</div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="rooms">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Where you'll sleep</span>
      <h2>Our rooms</h2>
      <p>A room for every kind of stay, from a single night on the road to a longer visit. Contact us for current rates.</p>
    </div>
    <div class="room-grid reveal">
      <div class="room-card">
        <div class="photo">
          <img src="~/images/hd/standard-room.jpg" asp-append-version="true" alt="Standard room at Golden Emerald Guest House" />
          <span class="photo-label">Standard Room</span>
        </div>
        <div class="room-body">
          <h3>Standard Room</h3>
          <div class="rate">Contact for rates</div>
          <p>Comfortable single or double bed, en-suite bathroom, and everything you need for a straightforward, restful night.</p>
          <a href="#contact" class="enquire">Enquire<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </div>
      <div class="room-card">
        <div class="photo">
          <img src="~/images/hd/family-room.jpg" asp-append-version="true" alt="Family room at Golden Emerald Guest House" />
          <span class="photo-label">Family Room</span>
        </div>
        <div class="room-body">
          <h3>Family Room</h3>
          <div class="rate">Contact for rates</div>
          <p>Extra space with room for the whole family, plus a private bathroom and a quiet corner of the compound.</p>
          <a href="#contact" class="enquire">Enquire<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="amenities" class="amenities-band">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">What's included</span>
      <h2>Amenities</h2>
      <p class="on-dark">Everything that makes a stay easier, included as standard.</p>
    </div>
    <div class="amen-grid reveal">
      <div class="amen-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 12l9-9 9 9M5 10v10h14V10"/></svg><h4>Gated compound</h4><p>Secure parking, watched around the clock.</p></div>
      <div class="amen-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 8.5a16 16 0 0120 0M5 12a11 11 0 0114 0M8.5 15.5a6 6 0 017 0"/><circle cx="12" cy="19" r="1" fill="currentColor"/></svg><h4>Wi-Fi access</h4><p>Stay connected throughout your visit.</p></div>
      <div class="amen-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3v7a6 6 0 0012 0V3M6 3h12M12 21v-4"/></svg><h4>Hot water</h4><p>Reliable hot showers, day or night.</p></div>
      <div class="amen-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 19V9l8-5 8 5v10M4 19h16M9 19v-6h6v6"/></svg><h4>On-site parking</h4><p>Space right at the door for cars and trucks.</p></div>
      <div class="amen-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 21V8l8-5 8 5v13M9 21v-7h6v7"/><path d="M12 12h.01"/></svg><h4>Restaurant and bar</h4><p>Fresh meals from our garden and farm animals, grown and raised on site.</p></div>
      <div class="amen-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M7 21h10M9 4V2M15 4V2"/></svg><h4>Laundry service</h4><p>Fresh clothes, ready when you need them.</p></div>
      <div class="amen-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg><h4>Flexible check-in</h4><p>Arriving late from the road? We'll be ready.</p></div>
      <div class="amen-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2l3 5 6 1-4.5 4 1 6-5.5-3-5.5 3 1-6L3 8l6-1z"/></svg><h4>Friendly staff</h4><p>Local knowledge and a genuine welcome.</p></div>
    </div>
  </div>
</section>

<section id="farm">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">From our farm</span>
      <h2>Grown and raised on site.</h2>
      <p>The meals at Golden Emerald come from our own land. Choose a step to see how it reaches your plate.</p>
    </div>
    <div class="farm reveal">
      <div class="farm-tabs" role="tablist" aria-label="From farm to plate">
        <button type="button" role="tab" class="farm-tab active" aria-selected="true" data-target="garden"><span class="n">1</span>The garden</button>
        <button type="button" role="tab" class="farm-tab" aria-selected="false" data-target="animals"><span class="n">2</span>The animals</button>
        <button type="button" role="tab" class="farm-tab" aria-selected="false" data-target="plate"><span class="n">3</span>Your plate</button>
      </div>
      <div class="farm-panels">
        <div class="farm-panel active" id="farm-garden">
          <div class="photo"><img src="~/images/hd/gallery-garden.jpg" asp-append-version="true" alt="Vegetables growing in rows in the garden" /></div>
          <div class="farm-copy"><h3>Vegetables from the garden</h3><p>Rows of greens and onions grow just outside, within sight of the rooms. They are picked when we need them.</p></div>
        </div>
        <div class="farm-panel" id="farm-animals">
          <div class="photo"><img src="~/images/hd/gallery-goats.jpg" asp-append-version="true" alt="Goats on the farm" /></div>
          <div class="farm-copy"><h3>Animals raised here</h3><p>Our goats and pigs are raised on the farm, so the meat on your plate comes from close by.</p></div>
        </div>
        <div class="farm-panel" id="farm-plate">
          <div class="photo"><img src="~/images/hd/gallery-grounds.jpg" asp-append-version="true" alt="The grounds of Golden Emerald Guest House" /></div>
          <div class="farm-copy"><h3>Fresh to your plate</h3><p>Nothing travels far. It goes from the ground and the farmyard to the kitchen, and then to you.</p></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="gallery">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">A look around</span>
      <h2>Gallery</h2>
      <p>The compound, garden, and animals around Golden Emerald Guest House.</p>
    </div>
    <div class="gallery-grid reveal">
      <div class="photo">
        <img src="~/images/hd/gallery-grounds.jpg" asp-append-version="true" alt="Garden and grounds at Golden Emerald Guest House" />
      </div>
      <div class="photo">
        <img src="~/images/hd/gallery-goats.jpg" asp-append-version="true" alt="Goats at Golden Emerald Guest House" />
      </div>
      <div class="photo">
        <img src="~/images/hd/gallery-pig.jpg" asp-append-version="true" alt="Pig at Golden Emerald Guest House" />
      </div>
    </div>
  </div>
</section>

<section id="location">
  <div class="wrap">
    <div class="loc-grid reveal">
      <div>
        <span class="eyebrow">Find us</span>
        <h2 class="loc-title">Right on the M18</h2>
        <div class="addr-line">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s7-7.5 7-12a7 7 0 10-14 0c0 4.5 7 12 7 12z"/><circle cx="12" cy="9" r="2.5"/></svg>
          <div><h4>Address</h4><p>M18, Zambia</p></div>
        </div>
        <div class="addr-line">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 19V9l8-5 8 5v10M4 19h16M9 19v-6h6v6"/></svg>
          <div><h4>Easy to spot</h4><p>Look for the Golden Emerald sign right along the road, hard to miss on the way through.</p></div>
        </div>
        <a href="https://www.google.com/maps/search/?api=1&query=Golden+Emerald+Guest+House+Zambia" target="_blank" rel="noopener" class="btn btn-clay">Get directions</a>
      </div>
    </div>
  </div>
</section>

<section id="faq">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Good to know</span>
      <h2>Common questions</h2>
    </div>
    <div class="faq reveal">
      <details>
        <summary>Can I check in late?</summary>
        <p>Yes. Arriving late from the road is fine. Message us on WhatsApp so we know to expect you.</p>
      </details>
      <details>
        <summary>Is there secure parking?</summary>
        <p>Yes. The compound is gated and watched around the clock, with space for cars and trucks.</p>
      </details>
      <details>
        <summary>What are the room rates?</summary>
        <p>Rates depend on the room and the length of your stay. Contact us and we will give you the current price.</p>
      </details>
      <details>
        <summary>Do you serve food?</summary>
        <p>Yes. We have a restaurant and bar, with fresh meals made from our own garden and farm.</p>
      </details>
    </div>
  </div>
</section>

<section id="contact">
  <div class="wrap">
    <div class="cta-band reveal">
      <div>
        <h2>Ready when you are.</h2>
        <p>Send us your dates and we'll reply with availability and rates.</p>
        <div class="contact-list">
          <a class="contact-item" href="tel:+260762512858">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6 19.8 19.8 0 01-3.1-8.7A2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.7a2 2 0 01-.4 2.1L8.1 9.7a16 16 0 006.2 6.2l1.2-1.2a2 2 0 012.1-.4c.9.3 1.8.5 2.7.6a2 2 0 011.7 2z"/></svg>
            <span><span class="l1">+260 762512858</span><br><span class="l2">Tap to call</span></span>
          </a>
        </div>
      </div>
      <form class="enquiry" id="enquiryForm">
        <h3>Request a room</h3>
        <label>Room
          <select id="enqRoom">
            <option>Standard Room</option>
            <option>Family Room</option>
          </select>
        </label>
        <div class="enq-row">
          <label>Check-in <input type="date" id="enqIn" /></label>
          <label>Check-out <input type="date" id="enqOut" /></label>
        </div>
        <label>Guests
          <input type="number" id="enqGuests" min="1" max="10" value="2" />
        </label>
        <label>Your name <input type="text" id="enqName" autocomplete="name" /></label>
        <button type="submit" class="btn btn-gold">Send on WhatsApp</button>
        <p class="enq-note">This opens WhatsApp with your request filled in. Nothing is sent until you press send.</p>
      </form>
    </div>
  </div>
</section>
